rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return exists(userDocRef());
    }

    function userDoc() {
      return get(userDocRef()).data;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isSellerOf(sellerId) {
      return isSignedIn() && userDocExists() && userDoc().sellerId == sellerId;
    }

    function hasBuyerRole() {
      return isSignedIn() && (
        (userDocExists() && userDoc().roles.hasAny(['buyer', 'both']))
        || isAdmin()
      );
    }

    function hasSellerRole() {
      return isSignedIn() && (
        (userDocExists() && userDoc().roles.hasAny(['seller', 'both']))
        || isAdmin()
      );
    }

    function immutableUserAuthFields() {
      return request.resource.data.roles == resource.data.roles
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.firebaseUid == resource.data.firebaseUid;
    }

    // Self-signup may only create a buyer profile; roles/sellerId are admin-managed later.
    function validUserCreate() {
      return request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.roles is list
        && request.resource.data.roles.size() == 1
        && request.resource.data.roles[0] == 'buyer'
        && (
          !('sellerId' in request.resource.data)
          || request.resource.data.sellerId == null
          || request.resource.data.sellerId == ''
        );
    }

    function validCapacitacionUserWrite() {
      return request.resource.data.keys().hasOnly(['uid', 'emailUpdatedAt'])
        && request.resource.data.uid == request.auth.uid;
    }

    function validLessonProgressWrite() {
      return request.resource.data.keys().hasOnly(['cursoSlug', 'leccionSlug', 'completedAt'])
        && request.resource.data.cursoSlug is string
        && request.resource.data.cursoSlug.size() > 0
        && request.resource.data.cursoSlug.size() <= 120
        && request.resource.data.leccionSlug is string
        && request.resource.data.leccionSlug.size() > 0
        && request.resource.data.leccionSlug.size() <= 120
        && request.resource.data.completedAt is timestamp;
    }

    match /categories/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && validUserCreate();
      allow update: if isAdmin() || (isOwner(uid) && immutableUserAuthFields());
      allow delete: if isAdmin();
    }

    match /sellers/{sellerId} {
      allow read: if resource.data.ownerId != null || isAdmin();
      allow create: if hasSellerRole()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == sellerId;
      allow update: if isAdmin()
        || (isSellerOf(sellerId)
          && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /listings/{id} {
      allow read: if resource.data.status == 'active' || isAdmin()
        || (isSignedIn() && userDocExists() && resource.data.sellerId == userDoc().sellerId);
      allow create: if hasSellerRole()
        && request.resource.data.sellerId == userDoc().sellerId;
      allow update: if isAdmin()
        || (isSignedIn()
          && userDocExists()
          && resource.data.sellerId == userDoc().sellerId
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    match /orders/{id} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid
        || (userDocExists() && resource.data.sellerId == userDoc().sellerId)
        || isAdmin()
      );
      allow write: if false;
    }

    match /payments/{id} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid
        || resource.data.sellerId == userDoc().sellerId
        || isAdmin()
      );
      allow write: if false;
    }

    match /escrows/{id} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid
        || (userDocExists() && resource.data.sellerId == userDoc().sellerId)
        || isAdmin()
      );
      allow write: if false;
    }

    match /payouts/{id} {
      allow read: if isSignedIn() && (
        (userDocExists() && resource.data.sellerId == userDoc().sellerId) || isAdmin()
      );
      allow write: if false;
    }

    match /carts/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /admin_audit/{id} {
      allow read, write: if isAdmin();
    }

    match /metrics_daily/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // web-capacitacion — progreso de lecciones (colección aislada)
    match /capacitacionUsers/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validCapacitacionUserWrite();
      allow delete: if isOwner(userId);

      match /lessonProgress/{progressId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validLessonProgressWrite();
        allow delete: if isOwner(userId);
      }
    }
  }
}
